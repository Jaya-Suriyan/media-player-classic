{
  "name": "media-player-classic-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "import": "tsx --env-file-if-exists=.env src/scripts/import-dir.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/lib-storage": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.9.1",
    "music-metadata": "^12.8.1",
    "nanoid": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
