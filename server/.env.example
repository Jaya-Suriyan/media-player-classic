# --- Server ---
PORT=3000
# Public origin of this API (used for absolute media URLs, e.g. for mobile apps). Optional.
PUBLIC_BASE_URL=
# Comma separated list of allowed browser origins (only needed if web app is on another origin)
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data

# --- Database (MongoDB, self-hosted or Atlas) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=media_player_classic

# --- Auth ---
# Change this! Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
# Optional: separate key for encrypting storage credentials saved in Admin → Storage (defaults to JWT_SECRET).
SETTINGS_SECRET=
# First admin account, created on first start if no users exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Storage: local | s3 ---
STORAGE_DRIVER=local
# local driver: where files are kept (default DATA_DIR/media)
LOCAL_STORAGE_DIR=

# s3 driver (AWS S3, Cloudflare R2, MinIO, Backblaze B2 ...)
S3_BUCKET=
S3_REGION=auto
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com   MinIO: http://localhost:9000
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# If the bucket is public / behind a CDN (e.g. R2 custom domain), set its base URL.
# Otherwise short-lived signed URLs are generated.
S3_PUBLIC_BASE_URL=

# --- Media ---
# Override ffmpeg binary (defaults to bundled ffmpeg-static)
FFMPEG_PATH=
TRANSCODE_CONCURRENCY=1
MAX_UPLOAD_MB=300
